# Client IDs for the third-party services CONTROL ROOM connects to.
# These are PUBLIC values — safe to ship in the bundle, NOT secrets.
# (PKCE OAuth was designed so SPAs can use a public client_id without a secret.)
#
# Local dev: copy this file to packages/web/.env.local and fill in the values.
# Vercel: set the same names in Project Settings → Environment Variables.

# Spotify OAuth client_id.
# Register an app at https://developer.spotify.com/dashboard
# Set the Redirect URI to your deploy URL (https://control-room-...vercel.app)
VITE_SPOTIFY_CLIENT_ID=

# GitHub OAuth App client_id.
# Register at https://github.com/settings/applications/new
# Set Authorization callback URL to the same deploy URL.
VITE_GITHUB_CLIENT_ID=
